# Leave empty when the SPA is served behind the same host as the API (e.g. /api proxied to Node).
# Set to your API origin when the client is on a different domain (no trailing slash).
# VITE_API_BASE_URL=https://api.example.com

# Google Sign-In (same Web client ID as GOOGLE_CLIENT_ID on the server)
# VITE_GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
