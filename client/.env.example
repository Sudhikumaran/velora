# --- Local dev ---
# Uses Vite proxy /api → http://localhost:5000 when this is unset.
# VITE_API_BASE_URL=

# Clerk (Dashboard → API Keys → Publishable key)
# VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# --- Production build (Vercel / Netlify / separate host) ---
# Public API URL, no trailing slash (required if SPA and API are on different domains).
# VITE_API_BASE_URL=https://your-api.up.railway.app
# VITE_CLERK_PUBLISHABLE_KEY=pk_live_...
