PORT=5000
NODE_ENV=development

# Local: mongodb://127.0.0.1:27017/velaro
# Atlas: mongodb+srv://USER:PASSWORD@cluster.mongodb.net/velaro?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/velaro

# Clerk (Dashboard → API Keys → Secret key)
CLERK_SECRET_KEY=sk_test_...

# One origin or comma-separated list (must match browser URL exactly, e.g. https://app.example.com)
CLIENT_URL=http://localhost:5173

# If 1, allow any https://*.vercel.app origin (preview URLs change each deploy). Optional for hobby; production can list exact URLs in CLIENT_URL instead.
# CORS_ALLOW_VERCEL_PREVIEWS=1

# Behind nginx/Render/Fly etc., set so rate limits and req.ip use the real client (values: 1 or true)
# TRUST_PROXY=1

# Optional branding for outgoing email
# APP_NAME=Velaro

# Password reset email (production). Example: Gmail app password, SendGrid SMTP, Mailgun, etc.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="Velaro <noreply@yourdomain.com>"

# Logging
# LOG_LEVEL=info
